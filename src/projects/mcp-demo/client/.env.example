# ── MCP demo: CLIENT side ── copy to .env (gitignored)

# LLM (provider:model). Groq alternative: groq:openai/gpt-oss-120b
LLM_MODEL=openai:gpt-4.1-mini
OPENAI_API_KEY=sk-...
# GROQ_API_KEY=gsk_...

# OAuth client credentials, issued by the server-side auth server (see server/.env)
AUTH_URL=http://127.0.0.1:9000
MCP_CLIENT_ID=demo-agent
MCP_CLIENT_SECRET=change-me-demo-agent

# Only used by protocol_demo.py to show a 403 (a client without sql:read)
READONLY_CLIENT_ID=readonly-weather
READONLY_CLIENT_SECRET=change-me-readonly

# MCP servers (each is a separate process)
WEATHER_MCP_URL=http://127.0.0.1:8001/mcp
DOCS_MCP_URL=http://127.0.0.1:8002/mcp
SQL_MCP_URL=http://127.0.0.1:8003/mcp

# LangSmith tracing
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=mcp-demo
