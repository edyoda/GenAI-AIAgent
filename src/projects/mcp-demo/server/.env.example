# ── MCP demo: SERVER side ── copy to .env (gitignored) and change the secrets
MCP_HOST=127.0.0.1
AUTH_PORT=9000
WEATHER_PORT=8001
DOCS_PORT=8002
SQL_PORT=8003
# AUTH_ISSUER=http://127.0.0.1:9000     # defaults to http://MCP_HOST:AUTH_PORT
TOKEN_TTL_SECONDS=3000                  # 50 min; the client refreshes automatically before expiry

# OAuth client registry (client_credentials). A client with no secret is disabled.
DEMO_AGENT_SECRET=change-me-demo-agent          # weather:read docs:read sql:read
READONLY_WEATHER_SECRET=change-me-readonly      # weather:read only  (403 demo on docs/sql)
DOCS_ADMIN_SECRET=change-me-docs-admin          # docs:read docs:write (can call ingest_documents)
