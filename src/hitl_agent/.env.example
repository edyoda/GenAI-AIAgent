# ─── Model ────────────────────────────────────────────────────────────────
# Format: provider:model   (provider = groq | openai)
# LLM_MODEL=groq:openai/gpt-oss-120b
# LLM_MODEL=groq:llama-3.3-70b-versatile
LLM_MODEL=openai:gpt-4.1-mini

# Optional: models to fall back to if the primary errors (comma-separated)
# LLM_FALLBACK_MODELS=groq:llama-3.3-70b-versatile

# Optional: leave unset for reasoning models (gpt-5 family rejects custom temperature)
# LLM_TEMPERATURE=0

# Optional: stop runaway tool loops after this many model calls per turn
# MAX_MODEL_CALLS=10

GROQ_API_KEY=gsk_...
OPENAI_API_KEY=sk-...

# ─── Any OpenAI-compatible server (use with LLM_MODEL=openai:<model>) ───────
# LLM_BASE_URL=http://localhost:11434/v1          # Ollama
# LLM_BASE_URL=http://localhost:8000/v1           # vLLM
# LLM_BASE_URL=https://openrouter.ai/api/v1       # OpenRouter
# LLM_BASE_URL=https://api.groq.com/openai/v1     # Groq via its OpenAI endpoint
# LLM_API_KEY=...                                 # key for that server (optional for local)

# ─── Langfuse (Project Settings -> API Keys). Leave blank to run untraced. ───
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# US region: https://us.cloud.langfuse.com
