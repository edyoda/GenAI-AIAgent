# Copy to src/agent-with-skills/.env and fill in your keys.

# ─── Model ────────────────────────────────────────────────────────────────
# Format: provider:model   (provider = groq | openai)
LLM_MODEL=openai:gpt-4.1-mini
# LLM_MODEL=groq:openai/gpt-oss-120b
# LLM_MODEL=groq:llama-3.3-70b-versatile

# Optional: leave unset for reasoning models (gpt-5 family rejects custom temperature)
# LLM_TEMPERATURE=0

OPENAI_API_KEY=sk-...
GROQ_API_KEY=gsk_...

# Any OpenAI-compatible server (use with LLM_MODEL=openai:<model>)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=...

# ─── LangSmith (smith.langchain.com -> Settings -> API Keys) ─────────────────
# Set LANGSMITH_TRACING=false (or leave the key blank) to run untraced.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=skills-agent-demo
# EU region:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
